# Firewall-mode KRB5 test
# Packet rules: allow packets for the KRB5 flow (transport verified from output)
accept:hook tcp:all any any <> any any (alert; sid:1000;)

# default drop

# App-layer rules: accept and alert on the KRB5 transaction hooks
accept:hook krb5:request_started any any -> any any (alert; sid:2000;)
accept:hook krb5:response_started any any -> any any (alert; sid:2001;)
accept:tx krb5:request_complete any any -> any any (alert; sid:2002;)

# default drop
