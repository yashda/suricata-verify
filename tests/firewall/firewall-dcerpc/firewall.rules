# Firewall-mode DCERPC test
# Packet rules: allow TCP session setup for the DCERPC flow
accept:hook tcp:all any any <> any any (alert; sid:1000;)

# default drop

# App-layer rules: accept and alert on the DCERPC transaction hooks
accept:hook dcerpc:request_started any any -> any any (alert; sid:2000;)
accept:hook dcerpc:response_started any any -> any any (alert; sid:2001;)
accept:tx dcerpc:request_complete any any -> any any (alert; sid:2002;)

# default drop
