# Firewall-mode NFS test
# Packet rules: allow UDP packets for the NFS flow (transport verified from output)
accept:hook udp:all any any <> any any (alert; sid:1000;)

# default drop

# App-layer rules: accept and alert on the NFS transaction hooks
accept:hook nfs:request_started any any -> any any (alert; sid:2000;)
accept:hook nfs:response_started any any -> any any (alert; sid:2001;)
accept:tx nfs:request_complete any any -> any any (alert; sid:2002;)

# default drop
