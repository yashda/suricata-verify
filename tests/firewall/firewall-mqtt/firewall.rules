# Firewall-mode MQTT test
# Packet rules: allow TCP session setup for the MQTT flow
accept:hook tcp:all any any <> any any (alert; sid:1000;)

# default drop

# App-layer rules: accept and alert on the MQTT transaction hooks
accept:hook mqtt:request_started any any -> any any (alert; sid:2000;)
accept:hook mqtt:response_started any any -> any any (alert; sid:2001;)
accept:tx mqtt:request_complete any any -> any any (alert; sid:2002;)

# default drop
