# Firewall-mode RDP test
# Packet rules: allow TCP session setup for the RDP flow
accept:hook tcp:all any any <> any any (alert; sid:1000;)

# default drop

# App-layer rules: accept and alert on the RDP transaction hooks
accept:hook rdp:request_started any any -> any any (alert; sid:2000;)
accept:hook rdp:response_started any any -> any any (alert; sid:2001;)
accept:tx rdp:request_complete any any -> any any (alert; sid:2002;)

# default drop
