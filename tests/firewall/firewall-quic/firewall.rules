# Firewall-mode QUIC test (UDP app-layer protocol)
# Packet rules: allow UDP packets for the QUIC flow
accept:hook udp:all any any <> any any (alert; sid:1000;)

# default drop

# App-layer rules: accept and alert on the QUIC transaction hooks
accept:hook quic:request_started any any -> any any (alert; sid:2000;)
accept:hook quic:response_started any any -> any any (alert; sid:2001;)
accept:tx quic:request_complete any any -> any any (alert; sid:2002;)

# default drop
