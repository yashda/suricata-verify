# Firewall-mode TFTP test (UDP app-layer protocol)
# Packet rules: allow UDP packets for the TFTP flow
accept:hook udp:all any any <> any any (alert; sid:1000;)

# default drop

# App-layer rules: accept and alert on the TFTP transaction hooks
accept:hook tftp:request_started any any -> any any (alert; sid:2000;)
accept:hook tftp:response_started any any -> any any (alert; sid:2001;)
accept:tx tftp:request_complete any any -> any any (alert; sid:2002;)

# default drop
